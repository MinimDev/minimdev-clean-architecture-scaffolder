@inherits LayoutComponentBase
@inject AppState State
@implements IDisposable

<div class="app-shell" data-theme="@_theme">
    <!-- ── Header ── -->
    <header class="app-header">
        <div class="logo">
            <div class="logo-icon">⚡</div>
            <span>MinimDevArchStudio</span>
        </div>
        @if (!string.IsNullOrEmpty(State.RootNamespace))
        {
            <span class="header-badge">📦 @State.RootNamespace</span>
        }
        <span class="header-badge" style="background:transparent; border-color:var(--border); color:var(--text-muted)">
            Entities: @State.Entities.Count
        </span>
        
        <div class="header-spacer"></div>

        <button class="theme-toggle-btn" @onclick="ToggleTheme" title="Toggle Theme (Dark / Light)">
            @(_theme == "dark" ? "🌙 Dark" : "☀️ Light")
        </button>

        <span class="header-badge">.NET Clean Architecture</span>
    </header>

    <!-- ── Sidebar ── -->
    <Sidebar />

    <!-- ── Main Canvas ── -->
    <main style="overflow:hidden;display:flex;flex-direction:column;">
        @Body
    </main>

    <!-- ── Right Panel ── -->
    <LayerSelector />
</div>

@code {
    private string _theme = "dark";

    protected override void OnInitialized()
    {
        _theme = Microsoft.Maui.Storage.Preferences.Default.Get("AppTheme", "dark");
        State.OnStateChanged += StateHasChanged;
    }

    private void ToggleTheme()
    {
        _theme = _theme == "dark" ? "light" : "dark";
        Microsoft.Maui.Storage.Preferences.Default.Set("AppTheme", _theme);
        StateHasChanged();
    }

    public void Dispose()
    {
        State.OnStateChanged -= StateHasChanged;
    }
}
