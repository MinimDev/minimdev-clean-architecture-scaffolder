@using ArchStudio.Models
@using ArchStudio.Services
@inject AppState State
@implements IDisposable

<div class="entity-builder">
    @if (State.ActiveEntity is null)
    {
        <div class="empty-state">
            <div class="empty-state-icon">⚡</div>
            <div class="empty-state-title">No entity selected</div>
            <div class="empty-state-sub">Create or select an entity from the sidebar<br/>to start building</div>
        </div>
    }
    else
    {
        var e = State.ActiveEntity;

        <div class="builder-header">
            <div class="builder-title">
                @(string.IsNullOrWhiteSpace(e.EntityName) ? "New Entity" : e.EntityName)
            </div>
        </div>

        <div class="builder-body">
            <!-- Config -->
            <div class="config-grid">
                <div class="form-group">
                    <label class="form-label">Entity Name</label>
                    <input class="form-input"
                           placeholder="e.g. Product"
                           value="@e.EntityName"
                           @oninput="ev => { e.EntityName = ev.Value?.ToString() ?? string.Empty; State.NotifyStateChanged(); }" />
                </div>
                <div class="form-group">
                    <label class="form-label">Table Name</label>
                    <input class="form-input"
                           placeholder="@(string.IsNullOrWhiteSpace(e.EntityName) ? "auto" : e.EntityNamePlural)"
                           @bind="e.TableName" />
                </div>
                <div class="form-group">
                    <label class="form-label">DB Schema</label>
                    <input class="form-input"
                           placeholder="dbo"
                           @bind="e.DbSchema" />
                </div>
                <div class="form-group">
                    <label class="form-label">UI Icon (MudBlazor)</label>
                    <input class="form-input"
                           list="mudIcons"
                           placeholder="Inventory2"
                           @bind="e.IconName" />
                    <datalist id="mudIcons">
                        <option value="Inventory2">Inventory2</option>
                        <option value="Category">Category</option>
                        <option value="ShoppingCart">ShoppingCart</option>
                        <option value="Folder">Folder</option>
                        <option value="Settings">Settings</option>
                        <option value="People">People</option>
                        <option value="Receipt">Receipt</option>
                        <option value="LocalOffer">LocalOffer</option>
                        <option value="Storefront">Storefront</option>
                    </datalist>
                </div>

                <!-- Base Entity Config -->
                <div class="form-group" style="grid-column: 1 / -1; background: var(--bg-surface); padding: 12px; border-radius: 6px; border: 1px solid var(--border-color);">
                    <label style="display:flex; align-items:center; gap:8px; cursor:pointer;">
                        <input type="checkbox" @bind="e.UseBaseEntity" />
                        <span style="font-weight:600; font-size:13px;">Inherit from Base Entity</span>
                    </label>
                    @if (e.UseBaseEntity)
                    {
                        <div style="display:flex; gap: 12px; margin-top: 10px;">
                            <div style="flex:1;">
                                <label class="form-label" style="font-size:11px;">Base Class Name</label>
                                <input class="form-input" @bind="e.BaseClassName" placeholder="e.g. BaseAuditableEntity" />
                            </div>
                            <div style="flex:1;">
                                <label class="form-label" style="font-size:11px;">Base Namespace</label>
                                <input class="form-input" @bind="e.BaseClassNamespace" placeholder="e.g. Domain.Common" />
                            </div>
                        </div>
                    }
                    <div style="margin-top: 10px;">
                        <label class="form-label" style="font-size:11px;">Interfaces (comma separated)</label>
                        <input class="form-input" @bind="e.Interfaces" placeholder="e.g. ISoftDeletable, IAuditable" />
                    </div>
                </div>
            </div>

            <!-- Derived Tokens -->
            @if (!string.IsNullOrWhiteSpace(e.EntityName))
            {
                <div class="tokens-row">
                    <div class="token-chip">
                        <span class="token-key">{{ "{{" }} EntityName }}</span>
                        <span class="token-val">@e.EntityName</span>
                    </div>
                    <div class="token-chip">
                        <span class="token-key">{{ "{{" }} Plural }}</span>
                        <span class="token-val">@e.EntityNamePlural</span>
                    </div>
                    <div class="token-chip">
                        <span class="token-key">{{ "{{" }} camelCase }}</span>
                        <span class="token-val">@e.EntityNameCamelCase</span>
                    </div>
                    <div class="token-chip">
                        <span class="token-key">{{ "{{" }} Namespace }}</span>
                        <span class="token-val">@(State.RootNamespace ?? "?")</span>
                    </div>
                </div>
            }

            <!-- Property Table Header & Presets -->
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 8px;">
                <div class="section-label" style="margin-bottom:0;">
                    Properties (@e.Properties.Count)
                </div>
                <div style="display:flex; gap:6px;">
                    <button class="btn-preset-mini" @onclick="() => AddMasterFields(e)" title="Add Code, Name, Description, IsActive">
                        ⚡ + Master Fields
                    </button>
                    <button class="btn-preset-mini" @onclick="() => AddAuditFields(e)" title="Add CreatedAtUtc, CreatedBy, LastModifiedAtUtc, LastModifiedBy">
                        🕒 + Audit Fields
                    </button>
                    <button class="btn-add-prop-top" @onclick="() => AddProperty(e)">
                        ＋ Add Property
                    </button>
                </div>
            </div>

            <div class="prop-table-wrap">
                <table class="prop-table">
                    <thead>
                        <tr>
                            <th style="width:190px">Property Name</th>
                            <th style="width:140px">Data Type</th>
                            <th style="width:50px;text-align:center" title="Nullable?">Null</th>
                            <th style="width:40px;text-align:center" title="Primary Key">PK</th>
                            <th style="width:50px;text-align:center" title="Public Setter (get; set;)">Pub</th>
                            <th style="width:55px;text-align:center" title="Navigation Relationship Property">Rel?</th>
                            <th style="width:90px;text-align:center">Constraints</th>
                            <th style="width:95px;text-align:center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!e.Properties.Any())
                        {
                            <tr class="empty-row">
                                <td colspan="8">No properties — click "+ Add Property" or use a quick preset above</td>
                            </tr>
                        }
                        @foreach (var prop in e.Properties)
                        {
                            <tr class="prop-row-enter @(prop.IsNavigationProperty ? "prop-row-rel" : "")" @key="prop.Id">
                                <td>
                                    <input class="td-input"
                                           placeholder="e.g. Name"
                                           @bind="prop.Name"
                                           @bind:event="oninput" />
                                </td>
                                <td>
                                    <input type="text" list="dataTypes-@prop.Id" class="td-input" 
                                           value="@prop.DataType" 
                                           @oninput="ev => OnDataTypeInput(prop, ev.Value?.ToString())" />
                                    <datalist id="dataTypes-@prop.Id">
                                        @foreach (var t in PropertyModel.SupportedTypes)
                                        {
                                            <option value="@t">@t</option>
                                        }
                                        @foreach (var we in State.Entities.Where(x => !string.IsNullOrEmpty(x.EntityName) && x != e))
                                        {
                                            <option value="@we.EntityName">@we.EntityName (Entity)</option>
                                            <option value="@($"List<{we.EntityName}>")">List&lt;@we.EntityName&gt; (Collection)</option>
                                        }
                                    </datalist>
                                </td>
                                <td style="text-align:center">
                                    <input type="checkbox" class="prop-checkbox" @bind="prop.IsNullable" />
                                </td>
                                <td style="text-align:center">
                                    <input type="checkbox" class="prop-checkbox" @bind="prop.IsPrimaryKey" />
                                </td>
                                <td style="text-align:center">
                                    <input type="checkbox" class="prop-checkbox" @bind="prop.HasPublicSetter" title="Check for { get; set; }, uncheck for { get; private set; }" />
                                </td>
                                <td style="text-align:center">
                                    <input type="checkbox" class="prop-checkbox" 
                                           @bind="prop.IsNavigationProperty" 
                                           disabled="@prop.IsPrimitiveType"
                                           style="@(prop.IsPrimitiveType ? "opacity:0.25; cursor:not-allowed;" : "cursor:pointer;")"
                                           title="@(prop.IsPrimitiveType ? "Relasi (Navigation Property) hanya untuk tipe Entitas kustom (bukan tipe primitif)" : "Is Navigation Property")" />
                                </td>
                                <td style="text-align:center">
                                    @if (prop.IsNavigationProperty)
                                    {
                                        <span class="badge-rel-pill" title="Configured in sub-card below">🔗 @prop.RelationshipType</span>
                                    }
                                    else if (prop.DataType == "string")
                                    {
                                        <input class="td-input" type="number" placeholder="∞" @bind="prop.MaxLength" title="Max Length" style="text-align:center;" />
                                    }
                                    else if (prop.DataType == "decimal" || prop.DataType == "double" || prop.DataType == "float")
                                    {
                                        <div style="display:flex;gap:2px">
                                            <input class="td-input" type="number" placeholder="18" @bind="prop.Precision" style="width:50%;padding:4px;text-align:center;" title="Precision" />
                                            <input class="td-input" type="number" placeholder="2" @bind="prop.Scale" style="width:50%;padding:4px;text-align:center;" title="Scale" />
                                        </div>
                                    }
                                    else
                                    {
                                        <span style="color:var(--text-muted);font-size:12px">—</span>
                                    }
                                </td>
                                <td>
                                    <div style="display:flex; gap:2px; justify-content:center; align-items:center;">
                                        <button class="btn-icon-action"
                                                @onclick="() => MoveUp(e, prop)"
                                                disabled="@(e.Properties.IndexOf(prop) == 0)"
                                                title="Move Up">▲</button>
                                        <button class="btn-icon-action"
                                                @onclick="() => MoveDown(e, prop)"
                                                disabled="@(e.Properties.IndexOf(prop) == e.Properties.Count - 1)"
                                                title="Move Down">▼</button>
                                        <button class="btn-icon-action"
                                                @onclick="() => DuplicateProp(e, prop)"
                                                title="Duplicate Property">📋</button>
                                        <button class="btn-icon-delete"
                                                @onclick="() => DeleteProperty(e, prop)"
                                                title="Remove">✕</button>
                                    </div>
                                </td>
                            </tr>
                            @if (prop.IsNavigationProperty)
                            {
                                <tr class="prop-relation-row" @key="@($"rel-card-{prop.Id}")">
                                    <td colspan="8" class="prop-relation-cell">
                                        <div class="relation-card">
                                            <div class="relation-card-header">
                                                <span class="relation-badge">🔗 EF Core Navigation Property Configuration</span>
                                                <span class="relation-helper">Tipe relasi & pemetaan foreign key untuk <strong>@prop.Name</strong></span>
                                            </div>
                                            <div class="relation-grid">
                                                <div class="form-group">
                                                    <label class="form-label" style="font-size:10px;">Relationship Type</label>
                                                    <select class="form-input" style="font-size:12px; padding:4px 8px;" @bind="prop.RelationshipType" @bind:after="State.NotifyStateChanged">
                                                        <option value="None">None</option>
                                                        <option value="ManyToOne">N:1 (Many to One - e.g. Belongs to Parent)</option>
                                                        <option value="OneToMany">1:N (One to Many - e.g. Has Many Children)</option>
                                                        <option value="OneToOne">1:1 (One to One)</option>
                                                        <option value="ManyToMany">N:M (Many to Many)</option>
                                                    </select>
                                                </div>
                                                <div class="form-group">
                                                    <label class="form-label" style="font-size:10px;">Foreign Key Name</label>
                                                    <input class="form-input" 
                                                           style="font-size:12px; padding:4px 8px;"
                                                           placeholder="@prop.ActualForeignKeyName" 
                                                           @bind="prop.ForeignKeyName" 
                                                           title="Leave blank for auto default" />
                                                </div>
                                                <div class="form-group">
                                                    <label class="form-label" style="font-size:10px;">Principal Key</label>
                                                    <input class="form-input" 
                                                           style="font-size:12px; padding:4px 8px;"
                                                           placeholder="Id" 
                                                           @bind="prop.PrincipalKeyName" 
                                                           title="Defaults to Id" />
                                                </div>
                                            </div>
                                            <div class="relation-preview">
                                                <span>💡 Auto-derived FK Property: <strong style="color:var(--accent-cyan)">@prop.ActualForeignKeyName</strong> (@prop.ForeignKeyType)</span>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
                <div class="add-prop-row">
                    <button class="btn-add-prop" @onclick="() => AddProperty(e)">
                        ＋ Add Property
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    protected override void OnInitialized()
        => State.OnStateChanged += StateHasChanged;

    private void AddProperty(EntityModel entity)
    {
        entity.Properties.Add(new PropertyModel());
        State.NotifyStateChanged();
    }

    private void DeleteProperty(EntityModel entity, PropertyModel prop)
    {
        entity.Properties.Remove(prop);
        State.NotifyStateChanged();
    }

    private void MoveUp(EntityModel entity, PropertyModel prop)
    {
        entity.MovePropertyUp(prop);
        State.NotifyStateChanged();
    }

    private void MoveDown(EntityModel entity, PropertyModel prop)
    {
        entity.MovePropertyDown(prop);
        State.NotifyStateChanged();
    }

    private void DuplicateProp(EntityModel entity, PropertyModel prop)
    {
        entity.DuplicateProperty(prop);
        State.NotifyStateChanged();
    }

    private void AddAuditFields(EntityModel entity)
    {
        entity.AddAuditFields();
        State.NotifyStateChanged();
    }

    private void AddMasterFields(EntityModel entity)
    {
        entity.AddMasterFields();
        State.NotifyStateChanged();
    }

    private void OnDataTypeInput(PropertyModel prop, string? newType)
    {
        prop.DataType = newType ?? string.Empty;
        State.NotifyStateChanged();
    }

    public void Dispose()
        => State.OnStateChanged -= StateHasChanged;
}
