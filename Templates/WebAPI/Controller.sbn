using Asp.Versioning;
{{~ if has_custom_types ~}}
using {{ root_namespace }}.Domain.Enums;
{{~ end ~}}
{{~ if opts.generate_create_command ~}}
using {{ root_namespace }}.Application.Features.{{ entity_name_plural }}.Commands.Create{{ entity_name }};
{{~ end ~}}
{{~ if opts.generate_update_command ~}}
using {{ root_namespace }}.Application.Features.{{ entity_name_plural }}.Commands.Update{{ entity_name }};
{{~ end ~}}
{{~ if opts.generate_delete_command ~}}
using {{ root_namespace }}.Application.Features.{{ entity_name_plural }}.Commands.Delete{{ entity_name }};
{{~ end ~}}
{{~ if opts.generate_get_all_query ~}}
using {{ root_namespace }}.Application.Features.{{ entity_name_plural }}.Queries.GetAll{{ entity_name_plural }};
{{~ end ~}}
{{~ if opts.generate_get_by_id_query ~}}
using {{ root_namespace }}.Application.Features.{{ entity_name_plural }}.Queries.Get{{ entity_name }}ById;
{{~ end ~}}
{{~ if require_authorization ~}}
using {{ root_namespace }}.Application.Common.Security;
using {{ root_namespace }}.Infrastructure.Identity.Security;
{{~ end ~}}
using Mediator;
using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;
using Microsoft.AspNetCore.RateLimiting;

namespace {{ root_namespace }}.WebAPI.Controllers;

/// <summary>
/// {{ entity_name_plural }} API Controller
/// </summary>
{{~ if require_authorization ~}}
[Authorize]
{{~ end ~}}
[ApiController]
[ApiVersion("1.0")]
[Route("api/v{version:apiVersion}/[controller]")]
[EnableRateLimiting("fixed")]
public class {{ entity_name_plural }}Controller : ControllerBase
{
    private readonly IMediator _mediator;

    public {{ entity_name_plural }}Controller(IMediator mediator)
    {
        _mediator = mediator;
    }
{{~ if opts.generate_get_all_query ~}}

    /// <summary>
    /// Get paginated list of {{ entity_name_plural | string.downcase }}
    /// </summary>
    [HttpGet]
    {{~ if require_authorization ~}}
    [HasPermission(Permissions.{{ entity_name_plural }}.View)]
    {{~ end ~}}
    [ProducesResponseType(StatusCodes.Status200OK)]
    public async Task<IActionResult> GetAll(
        [FromQuery] int pageNumber = 1,
        [FromQuery] int pageSize = 10,
        [FromQuery] string? searchTerm = null)
    {
        var query = new GetAll{{ entity_name_plural }}Query
        {
            PageNumber = pageNumber,
            PageSize = pageSize,
            SearchTerm = searchTerm
        };

        var result = await _mediator.Send(query);

        if (!result.IsSuccess)
            return BadRequest(result);

        return Ok(result);
    }
{{~ end ~}}
{{~ if opts.generate_get_by_id_query ~}}

    /// <summary>
    /// Get {{ entity_name | string.downcase }} by ID
    /// </summary>
    [HttpGet("{id}")]
    {{~ if require_authorization ~}}
    [HasPermission(Permissions.{{ entity_name_plural }}.View)]
    {{~ end ~}}
    [ProducesResponseType(StatusCodes.Status200OK)]
    [ProducesResponseType(StatusCodes.Status404NotFound)]
    public async Task<IActionResult> GetById(Guid id)
    {
        var query = new Get{{ entity_name }}ByIdQuery(id);
        var result = await _mediator.Send(query);

        if (!result.IsSuccess)
            return NotFound(result);

        return Ok(result);
    }
{{~ end ~}}
{{~ if opts.generate_create_command ~}}

    /// <summary>
    /// Create a new {{ entity_name | string.downcase }}
    /// </summary>
    [HttpPost]
    {{~ if require_authorization ~}}
    [HasPermission(Permissions.{{ entity_name_plural }}.Create)]
    {{~ end ~}}
    [ProducesResponseType(StatusCodes.Status201Created)]
    [ProducesResponseType(StatusCodes.Status400BadRequest)]
    public async Task<IActionResult> Create([FromBody] Create{{ entity_name }}Command command)
    {
        var result = await _mediator.Send(command);

        if (!result.IsSuccess)
            return BadRequest(result);

        return CreatedAtAction(nameof({{~ if opts.generate_get_by_id_query ~}}GetById{{~ else ~}}GetAll{{~ end ~}}), new { id = result.Data }, result);
    }
{{~ end ~}}
{{~ if opts.generate_update_command ~}}

    /// <summary>
    /// Update a {{ entity_name | string.downcase }} by id
    /// </summary>
    [HttpPut("{id}")]
    {{~ if require_authorization ~}}
    [HasPermission(Permissions.{{ entity_name_plural }}.Edit)]
    {{~ end ~}}
    [ProducesResponseType(StatusCodes.Status204NoContent)]
    [ProducesResponseType(StatusCodes.Status400BadRequest)]
    [ProducesResponseType(StatusCodes.Status404NotFound)]
    public async Task<IActionResult> Update(Guid id, [FromBody] Update{{ entity_name }}Dto body)
    {
        var command = new Update{{ entity_name }}Command(id)
        {
{{~ for prop in dto_properties ~}}
            {{ prop.name }} = body.{{ prop.name }}{{ if !for.last }},{{ end }}
{{~ end ~}}
        };

        var result = await _mediator.Send(command);

        if (!result.IsSuccess)
            return BadRequest(result);

        return NoContent();
    }
{{~ end ~}}
{{~ if opts.generate_delete_command ~}}

    /// <summary>
    /// Delete a {{ entity_name | string.downcase }} by id
    /// </summary>
    [HttpDelete("{id}")]
    {{~ if require_authorization ~}}
    [HasPermission(Permissions.{{ entity_name_plural }}.Delete)]
    {{~ end ~}}
    [ProducesResponseType(StatusCodes.Status204NoContent)]
    [ProducesResponseType(StatusCodes.Status404NotFound)]
    public async Task<IActionResult> Delete(Guid id)
    {
        var command = new Delete{{ entity_name }}Command(id);
        var result = await _mediator.Send(command);

        if (!result.IsSuccess)
            return NotFound(result);

        return NoContent();
    }
{{~ end ~}}
}
{{~ if opts.generate_update_command ~}}

/// <summary>
/// DTO for updating a {{ entity_name | string.downcase }}
/// </summary>
public record Update{{ entity_name }}Dto(
{{~ for prop in dto_properties ~}}
    {{ prop.data_type }}{{ if prop.is_nullable }}?{{ end }} {{ prop.name }}{{ if !for.last }}, {{ end }}
{{~ end ~}}
);
{{~ end ~}}
