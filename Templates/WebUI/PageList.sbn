@page "/{{ entity_name_plural | string.downcase }}"
@using {{ root_namespace }}.WebUI.Services
@using {{ root_namespace }}.WebUI.Services.Models
@inject {{ entity_name_plural }}Client Client
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject TokenProvider TokenProvider

<AuthorizeView>
    <Authorized>
        <div class="page-container pa-4">
            <!-- Header Section using PageHeader Shared Component -->
            <PageHeader Title="{{ entity_name_plural }}"
                        Subtitle="Browse, search, and manage {{ entity_name_plural | string.downcase }}"
                        Icon="@Icons.Material.Rounded.{{ icon_name }}"
                        BadgeText="@($"{_totalItems} Items")">
                <Actions>
                    <div class="d-flex align-center gap-2 flex-wrap">
                        <MudTextField T="string" Value="@_searchString" ValueChanged="@OnSearchChanged"
                                      Placeholder="Search {{ entity_name_plural | string.downcase }}..." Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Small"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                                      Class="rounded-lg bg-surface" Style="min-width: 200px; max-width: 280px; font-size: 0.85rem;" />

                        <!-- View Switcher: Grid vs Table -->
                        <div class="d-flex align-center border-solid border-1 rounded-lg overflow-hidden" style="border-color: var(--mud-palette-lines-default); background: var(--mud-palette-surface);">
                            <MudTooltip Text="Grid View">
                                <MudIconButton Icon="@Icons.Material.Rounded.GridView"
                                               Size="Size.Small"
                                               Color="@(!_isTableView ? Color.Primary : Color.Default)"
                                               OnClick="@(() => _isTableView = false)"
                                               Style="@(!_isTableView ? "background: rgba(var(--mud-palette-primary-rgb), 0.12);" : "")" />
                            </MudTooltip>
                            <MudTooltip Text="Table View">
                                <MudIconButton Icon="@Icons.Material.Rounded.ViewList"
                                               Size="Size.Small"
                                               Color="@(_isTableView ? Color.Primary : Color.Default)"
                                               OnClick="@(() => _isTableView = true)"
                                               Style="@(_isTableView ? "background: rgba(var(--mud-palette-primary-rgb), 0.12);" : "")" />
                            </MudTooltip>
                        </div>

                        @if (TokenProvider.HasPermission(Permissions.{{ entity_name_plural }}.Create))
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                                       OnClick="OpenCreateDialog" Class="rounded-lg text-nowrap hover-lift px-3 py-1-5 font-weight-bold"
                                       Size="Size.Small">
                                New {{ entity_name }}
                            </MudButton>
                        }
                    </div>
                </Actions>
            </PageHeader>

            <!-- Loading State -->
            @if (_isLoading)
            {
                @if (_isTableView)
                {
                    <TableSkeleton Rows="8" Columns="5" />
                }
                else
                {
                    <MudGrid Spacing="3">
                        @for (int i = 0; i < 8; i++)
                        {
                            <MudItem xs="12" sm="6" md="4" lg="3">
                                <MudCard Elevation="0" Class="rounded-xl overflow-hidden border-solid border-1" Style="border-color: var(--mud-palette-lines-default);">
                                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="100px" Animation="Animation.Wave" />
                                    <MudCardContent Class="pa-3">
                                        <MudSkeleton Width="75%" Height="24px" Class="mb-2" Animation="Animation.Wave" />
                                        <MudSkeleton Width="40%" Height="20px" Class="mb-3" Animation="Animation.Wave" />
                                        <MudSkeleton Width="100%" Height="14px" Animation="Animation.Wave" />
                                    </MudCardContent>
                                    <MudCardActions Class="pa-3 pt-0">
                                        <MudSkeleton Width="48px" Height="28px" Class="ml-auto" Animation="Animation.Wave" />
                                    </MudCardActions>
                                </MudCard>
                            </MudItem>
                        }
                    </MudGrid>
                }
            }
            else if (_items == null || !_items.Any())
            {
                <!-- Empty State using Shared Component -->
                <EmptyState Title="No {{ entity_name_plural }} Found"
                            Description="You haven't added any {{ entity_name_plural | string.downcase }} or none match your search criteria. Create your first {{ entity_name | string.downcase }} to get started!"
                            Icon="@Icons.Material.Rounded.{{ icon_name }}"
                            ActionText="@(TokenProvider.HasPermission(Permissions.{{ entity_name_plural }}.Create) ? "Create Your First {{ entity_name }}" : null)"
                            ActionIcon="@Icons.Material.Rounded.Add"
                            OnActionClick="OpenCreateDialog" />
            }
            else if (_isTableView)
            {
                <!-- DATA TABLE VIEW -->
                <MudTable Items="_items" Elevation="0" Class="rounded-xl border-solid border-1 overflow-hidden"
                          Style="border-color: var(--mud-palette-lines-default); background: var(--mud-palette-surface);"
                          Dense="true" Hover="true">
                    <HeaderContent>
{{~ for prop in dto_properties ~}}
                        <MudTh>{{ prop.name }}</MudTh>
{{~ end ~}}
{{~ if use_base_entity ~}}
                        <MudTh>Created</MudTh>
{{~ end ~}}
                        <MudTh Style="text-align: right; width: 140px;">Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
{{~ for prop in dto_properties ~}}
                        <MudTd DataLabel="{{ prop.name }}">@context.{{ prop.name }}</MudTd>
{{~ end ~}}
{{~ if use_base_entity ~}}
                        <MudTd DataLabel="Created">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @context.CreatedAt.ToString("MMM dd, yyyy")
                            </MudText>
                        </MudTd>
{{~ end ~}}
                        <MudTd DataLabel="Actions" Style="text-align: right;">
                            <div class="d-inline-flex align-center gap-1">
                                <MudTooltip Text="View Details">
                                    <MudIconButton Icon="@Icons.Material.Rounded.Visibility" Size="Size.Small" Class="action-icon-btn action-view" OnClick="@(() => OpenDetailDialog(context))" />
                                </MudTooltip>
                                @if (TokenProvider.HasPermission(Permissions.{{ entity_name_plural }}.Edit))
                                {
                                    <MudTooltip Text="Edit">
                                        <MudIconButton Icon="@Icons.Material.Rounded.Edit" Size="Size.Small" Class="action-icon-btn action-edit" OnClick="@(() => OpenEditDialog(context))" />
                                    </MudTooltip>
                                }
                                @if (TokenProvider.HasPermission(Permissions.{{ entity_name_plural }}.Delete))
                                {
                                    <MudTooltip Text="Delete">
                                        <MudIconButton Icon="@Icons.Material.Rounded.DeleteOutline" Size="Size.Small" Class="action-icon-btn action-delete" OnClick="@(() => DeleteItem(context))" />
                                    </MudTooltip>
                                }
                            </div>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
            else
            {
                <!-- GRID CARD VIEW -->
                <MudGrid Spacing="3">
                    @foreach (var item in _items)
                    {
                        var currentTheme = GetCardTheme(item.Id.ToString());
                        <MudItem xs="12" sm="6" md="4" lg="3" @key="item.Id" Class="d-flex flex-column">
                            <MudCard Elevation="0" Class="rounded-xl product-card flex-column d-flex h-100 flex-grow-1 border-solid border-1" Style="border-color: var(--mud-palette-lines-default);">
                                <div class="product-card-banner" style="background: @currentTheme.gradient; height: 72px; display: flex; align-items: center; justify-content: center;">
                                    <MudIcon Icon="@Icons.Material.Rounded.{{ icon_name }}" Size="Size.Medium" Style="color: white; filter: drop-shadow(0 2px 4px rgba(0,0,0,0.15));" />
                                </div>
                                <MudCardContent Class="flex-grow-1 pa-3 pt-3 pb-2 d-flex flex-column">
{{~ if (dto_properties | array.size) > 0 ~}}
                                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-1 text-truncate" title="@item.{{ dto_properties[0].name }}">@item.{{ dto_properties[0].name }}</MudText>
{{~ end ~}}
{{~ for prop in dto_properties ~}}
    {{~ if !for.first ~}}
                                    <div class="d-flex justify-space-between mt-1">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">{{ prop.name }}:</MudText>
                                        <MudText Typo="Typo.caption" Class="font-weight-medium text-truncate" Style="max-width: 140px;">@item.{{ prop.name }}</MudText>
                                    </div>
    {{~ end ~}}
{{~ end ~}}
                                    <div class="product-card-footer d-flex align-center justify-space-between mt-auto pt-2 border-t border-solid" style="border-color: var(--mud-palette-lines-default) !important;">
{{~ if use_base_entity ~}}
                                        <span class="d-flex align-center gap-1">
                                            <MudIcon Icon="@Icons.Material.Outlined.Event" Style="font-size: 0.72rem;" Color="Color.Secondary" />
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@item.CreatedAt.ToString("MMM dd")</MudText>
                                        </span>
{{~ else ~}}
                                        <span></span>
{{~ end ~}}
                                        <div class="d-flex align-center gap-1">
                                            <MudTooltip Text="View Details">
                                                <MudIconButton Icon="@Icons.Material.Rounded.ArrowForward" Size="Size.Small" Class="action-icon-btn action-view" OnClick="@(() => OpenDetailDialog(item))" />
                                            </MudTooltip>
                                            @if (TokenProvider.HasPermission(Permissions.{{ entity_name_plural }}.Edit))
                                            {
                                                <MudTooltip Text="Edit">
                                                    <MudIconButton Icon="@Icons.Material.Rounded.Edit" Size="Size.Small" Class="action-icon-btn action-edit" OnClick="@(() => OpenEditDialog(item))" />
                                                </MudTooltip>
                                            }
                                            @if (TokenProvider.HasPermission(Permissions.{{ entity_name_plural }}.Delete))
                                            {
                                                <MudTooltip Text="Delete">
                                                    <MudIconButton Icon="@Icons.Material.Rounded.DeleteOutline" Size="Size.Small" Class="action-icon-btn action-delete" OnClick="@(() => DeleteItem(item))" />
                                                </MudTooltip>
                                            }
                                        </div>
                                    </div>
                                </MudCardContent>
                            </MudCard>
                        </MudItem>
                    }
                </MudGrid>
            }

            <!-- Pagination -->
            <div class="d-flex justify-center mt-6 mb-2">
                <MudPagination Color="Color.Primary" Count="@_totalPages" Selected="@_currentPage" SelectedChanged="OnPageChanged"
                               ShowFirstButton="true" ShowLastButton="true" Variant="Variant.Filled" Class="rounded-xl shadow-sm" Size="Size.Small"/>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <MudContainer MaxWidth="MaxWidth.Small" Class="mt-12 text-center">
            <MudPaper Class="pa-8 rounded-2xl" Elevation="0" Style="border: 1px solid var(--mud-palette-lines-default);">
                <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Large" Color="Color.Warning" Class="mb-3" />
                <MudText Typo="Typo.h5" Class="font-weight-bold mb-2">Sign In Required</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                    Please sign in to your account to view and manage {{ entity_name_plural | string.downcase }}.
                </MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/login" Class="rounded-lg px-6">
                    Sign In
                </MudButton>
            </MudPaper>
        </MudContainer>
    </NotAuthorized>
</AuthorizeView>

@code {
    private List<{{ entity_name }}Dto> _items = new();
    private bool _isLoading = true;
    private string? _searchString;
    private int _currentPage = 1;
    private int _pageSize = 8;
    private int _totalItems = 0;
    private int _totalPages = 1;
    private bool _isTableView = false;

    private static readonly (string gradient, string iconColor)[] CardPalettes = new[]
    {
        ("linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%)", "#ffffff"),
        ("linear-gradient(135deg, #0284c7 0%, #0369a1 100%)", "#ffffff"),
        ("linear-gradient(135deg, #059669 0%, #047857 100%)", "#ffffff"),
        ("linear-gradient(135deg, #d97706 0%, #b45309 100%)", "#ffffff"),
        ("linear-gradient(135deg, #db2777 0%, #9333ea 100%)", "#ffffff"),
        ("linear-gradient(135deg, #475569 0%, #334155 100%)", "#ffffff")
    };

    private (string gradient, string iconColor) GetCardTheme(string id)
    {
        uint hash = (uint)(id?.GetHashCode() ?? 0);
        return CardPalettes[hash % (uint)CardPalettes.Length];
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadData();
        }
    }

    private async Task OnSearchChanged(string text)
    {
        _searchString = text;
        _currentPage = 1;
        await LoadData();
    }

    private async Task OnPageChanged(int page)
    {
        _currentPage = page;
        await LoadData();
    }

    private async Task LoadData()
    {
        _isLoading = true;
        StateHasChanged();

        var result = await Client.Get{{ entity_name_plural }}Async(_currentPage, _pageSize, _searchString);
        if (result.IsSuccess && result.Data != null)
        {
            _items = result.Data.Items.ToList();
            _totalItems = result.Data.TotalCount;
            _totalPages = result.Data.TotalPages > 0 ? result.Data.TotalPages : 1;
        }
        else
        {
            _items = new();
            _totalItems = 0;
            _totalPages = 1;
            if (!string.IsNullOrEmpty(result.Error))
            {
                Snackbar.Add($"Failed to load {{ entity_name_plural | string.downcase }}: {result.Error}", Severity.Error);
            }
        }

        _isLoading = false;
        StateHasChanged();
    }

    private async Task OpenCreateDialog()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<Create{{ entity_name }}Dialog>("New {{ entity_name }}", options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            _currentPage = 1;
            await LoadData();
        }
    }

    private async Task OpenEditDialog({{ entity_name }}Dto item)
    {
        var parameters = new DialogParameters<Edit{{ entity_name }}Dialog>
        {
            { x => x.Item, item }
        };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<Edit{{ entity_name }}Dialog>("Edit {{ entity_name }}", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            await LoadData();
        }
    }

    private async Task OpenDetailDialog({{ entity_name }}Dto item)
    {
        var parameters = new DialogParameters<{{ entity_name }}DetailDialog>
        {
            { x => x.Item, item }
        };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        await DialogService.ShowAsync<{{ entity_name }}DetailDialog>("{{ entity_name }} Details", parameters, options);
    }

    private async Task DeleteItem({{ entity_name }}Dto item)
    {
        var parameters = new DialogParameters<ConfirmDeleteDialog>
        {
            { x => x.Title, "Delete {{ entity_name }}" },
            { x => x.Message, "Are you sure you want to permanently delete this {{ entity_name | string.downcase }}? All linked records will be affected." },
            { x => x.ItemName, item.{{ if (dto_properties | array.size) > 0 }}{{ dto_properties[0].name }}{{ else }}Id.ToString(){{ end }} },
            { x => x.ConfirmText, "Delete {{ entity_name }}" },
            { x => x.ConfirmColor, Color.Error }
        };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.ExtraSmall };
        var dialog = await DialogService.ShowAsync<ConfirmDeleteDialog>("Delete {{ entity_name }}", parameters, options);
        var dialogResult = await dialog.Result;

        if (dialogResult is not null && !dialogResult.Canceled)
        {
            var result = await Client.Delete{{ entity_name }}Async(item.Id);
            if (result.IsSuccess)
            {
                Snackbar.Add("{{ entity_name }} deleted successfully", Severity.Success);
                if (_items.Count == 1 && _currentPage > 1)
                    _currentPage--;
                await LoadData();
            }
            else
            {
                Snackbar.Add($"Failed to delete {{ entity_name | string.downcase }}: {result.Error}", Severity.Error);
            }
        }
    }
}
