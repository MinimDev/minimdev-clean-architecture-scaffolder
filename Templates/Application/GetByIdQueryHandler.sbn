using {{ root_namespace }}.Domain.Enums;
{{~ end ~}}
using {{ root_namespace }}.Application.Common.Interfaces;
using {{ root_namespace }}.Application.Common.Models;
using {{ root_namespace }}.Application.Features.{{ entity_name_plural }}.Queries.GetAll{{ entity_name_plural }};
using Mapster;
using Mediator;
using Microsoft.EntityFrameworkCore;

namespace {{ root_namespace }}.Application.Features.{{ entity_name_plural }}.Queries.Get{{ entity_name }}ById;

/// <summary>
/// Handler untuk Get{{ entity_name }}ByIdQuery
/// </summary>
public class Get{{ entity_name }}ByIdQueryHandler : IRequestHandler<Get{{ entity_name }}ByIdQuery, Result<{{ entity_name }}Dto>>
{
    private readonly IApplicationDbContext _context;

    public Get{{ entity_name }}ByIdQueryHandler(IApplicationDbContext context)
    {
        _context = context;
    }

    public async ValueTask<Result<{{ entity_name }}Dto>> Handle(Get{{ entity_name }}ByIdQuery request, CancellationToken cancellationToken)
    {
        try
        {
            var item = await _context.{{ entity_name_plural }}
                .AsNoTracking()
                .Where(p => p.Id == request.Id)
                .ProjectToType<{{ entity_name }}Dto>()
                .FirstOrDefaultAsync(cancellationToken);

            if (item == null)
            {
                return Result<{{ entity_name }}Dto>.Failure($"{{ entity_name }} with ID {request.Id} not found");
            }

            return Result<{{ entity_name }}Dto>.Success(item);
        }
        catch (Exception ex)
        {
            return Result<{{ entity_name }}Dto>.Failure($"An error occurred while retrieving the {{ entity_name | string.downcase }}: {ex.Message}");
        }
    }
}
