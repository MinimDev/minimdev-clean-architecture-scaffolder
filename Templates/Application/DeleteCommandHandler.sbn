using {{ root_namespace }}.Application.Common.Interfaces;
using {{ root_namespace }}.Application.Common.Models;
using {{ root_namespace }}.Domain.Entities;
using Mediator;

namespace {{ root_namespace }}.Application.Features.{{ entity_name_plural }}.Commands.Delete{{ entity_name }};

public class Delete{{ entity_name }}CommandHandler : IRequestHandler<Delete{{ entity_name }}Command, Result>
{
    private readonly IUnitOfWork _unitOfWork;

    public Delete{{ entity_name }}CommandHandler(IUnitOfWork unitOfWork)
    {
        _unitOfWork = unitOfWork;
    }

    public async ValueTask<Result> Handle(Delete{{ entity_name }}Command request, CancellationToken cancellationToken)
    {
        try
        {
            var {{ entity_name_camel }} = await _unitOfWork.Repository<{{ entity_name }}>().GetByIdAsync(request.Id, cancellationToken);
            if ({{ entity_name_camel }} == null)
            {
                return Result.Failure($"{{ entity_name }} with ID {request.Id} not found");
            }

            _unitOfWork.Repository<{{ entity_name }}>().Delete({{ entity_name_camel }});
            await _unitOfWork.SaveChangesAsync(cancellationToken);

            return Result.Success();
        }
        catch (Exception ex)
        {
            return Result.Failure($"An error occurred while deleting the {{ entity_name | string.downcase }}: {ex.Message}");
        }
    }
}
