namespace {{ root_namespace }}.Application.Features.{{ entity_name_plural }}.Queries.GetAll{{ entity_name_plural }};

/// <summary>
/// Handler untuk GetAll{{ entity_name_plural }}Query
/// </summary>
public class GetAll{{ entity_name_plural }}QueryHandler : IRequestHandler<GetAll{{ entity_name_plural }}Query, Result<PaginatedList<{{ entity_name }}Dto>>>
{
    private readonly IApplicationDbContext _context;

    public GetAll{{ entity_name_plural }}QueryHandler(IApplicationDbContext context)
    {
        _context = context;
    }

    public async ValueTask<Result<PaginatedList<{{ entity_name }}Dto>>> Handle(GetAll{{ entity_name_plural }}Query request, CancellationToken cancellationToken)
    {
        try
        {
            var query = _context.{{ entity_name_plural }}.AsQueryable();

            if (!string.IsNullOrWhiteSpace(request.SearchTerm))
            {
                var searchTerm = request.SearchTerm.ToLower();
                {{~ string_props = [] ~}}
                {{~ for prop in dto_properties ~}}
                    {{~ if prop.data_type == "string" ~}}
                        {{~ string_props = string_props | array.add prop.name ~}}
                    {{~ end ~}}
                {{~ end ~}}
                {{~ if (string_props | array.size) > 0 ~}}
                query = query.Where(p => 
                    {{~ for sp in string_props ~}}
                    (p.{{ sp }} != null && p.{{ sp }}.ToLower().Contains(searchTerm)){{ if !for.last }} ||{{ end }}
                    {{~ end ~}}
                );
                {{~ end ~}}
            }

            var dtos = query.ProjectToType<{{ entity_name }}Dto>();

            var paginatedList = await PaginatedList<{{ entity_name }}Dto>.CreateAsync(
                dtos,
                request.PageNumber,
                request.PageSize
            );

            return Result<PaginatedList<{{ entity_name }}Dto>>.Success(paginatedList);
        }
        catch (Exception ex)
        {
            return Result<PaginatedList<{{ entity_name }}Dto>>.Failure($"An error occurred while retrieving {{ entity_name_plural | string.downcase }}: {ex.Message}");
        }
    }
