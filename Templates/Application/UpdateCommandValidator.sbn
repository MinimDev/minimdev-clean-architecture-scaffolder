{{~ if has_custom_types ~}}
using {{ root_namespace }}.Domain.Enums;
{{~ end ~}}
using FluentValidation;

namespace {{ root_namespace }}.Application.Features.{{ entity_name_plural }}.Commands.Update{{ entity_name }};

/// <summary>
/// Validator untuk Update{{ entity_name }}Command
/// </summary>
public class Update{{ entity_name }}CommandValidator : AbstractValidator<Update{{ entity_name }}Command>
{
    public Update{{ entity_name }}CommandValidator()
    {
        RuleFor(v => v.Id)
            .NotEmpty().WithMessage("Id is required.");

{{~ for prop in dto_properties ~}}
        {{~ if !prop.is_nullable && prop.data_type == "string" ~}}
        RuleFor(v => v.{{ prop.name }})
            .NotEmpty().WithMessage("{{ prop.name }} is required."){{ if prop.max_length }}
            .MaximumLength({{ prop.max_length }}).WithMessage("{{ prop.name }} must not exceed {{ prop.max_length }} characters.");{{ else }};{{ end }}
        {{~ else if !prop.is_nullable && (prop.data_type == "int" || prop.data_type == "decimal" || prop.data_type == "double" || prop.data_type == "float" || prop.data_type == "long") ~}}
        RuleFor(v => v.{{ prop.name }})
            .GreaterThanOrEqualTo(0).WithMessage("{{ prop.name }} must be greater than or equal to 0.");
        {{~ else if !prop.is_nullable && prop.data_type == "Guid" ~}}
        RuleFor(v => v.{{ prop.name }})
            .NotEmpty().WithMessage("{{ prop.name }} is required.");
        {{~ else if prop.data_type == "string" && prop.max_length ~}}
        RuleFor(v => v.{{ prop.name }})
            .MaximumLength({{ prop.max_length }}).WithMessage("{{ prop.name }} must not exceed {{ prop.max_length }} characters.");
        {{~ end ~}}

{{~ end ~}}
    }
}
